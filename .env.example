VITE_ASSISTANT_ENDPOINT=/api/assistant

# Server-side only. Use AI Gateway API key locally, or Vercel OIDC in deployment.
# Never prefix this with VITE_ and never commit the real value.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.8-flash

# Direct Gemini API (takes precedence over AI Gateway). Keep these on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
